{
  "name": "mctest-mcp",
  "version": "0.2.0",
  "description": "MCP server that lets Claude Code and other AI agents drive a running Minecraft client (via the MCTest mod) to test mods",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "minecraft",
    "mod-testing",
    "fabric",
    "neoforge",
    "claude",
    "automation"
  ],
  "author": "CoolerProMC",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mctest-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node test-client.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "homepage": "https://mctest.coolerpromc.com/"
}
